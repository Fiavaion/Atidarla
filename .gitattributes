# Project files are compared byte for byte (canonical form, CLAUDE.md rule 8),
# so they keep LF line endings on every OS.
*.toml text eol=lf
*.fs text eol=lf
*.vs text eol=lf
*.wgsl text eol=lf
*.md text eol=lf

*.wav binary
*.mov binary
*.png binary
*.jpg binary
*.rgba binary
# Example media some tests compare byte for byte with their generators.
*.obj text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.xyz text eol=lf
*.atk text eol=lf
*.exr binary
*.ply binary
*.spz binary
*.sog binary
*.webp binary
*.lsrpc binary

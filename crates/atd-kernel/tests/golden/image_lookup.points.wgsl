// Generated by atd-kernel from a Points kernel. Do not edit: edit the kernel.

struct AtdUniforms {
    // time, time step, frame, 0
    globals: vec4f,
    // width, height, 1 / width, 1 / height (pixels)
    res: vec4f,
    p: array<vec4f, 1>,
}

// Parameters:
//   p[0] float = ch("height")

struct AtdHeader {
    count: u32,
    capacity: u32,
}

@group(0) @binding(0) var<storage, read> atd_header: AtdHeader;
@group(0) @binding(1) var<uniform> atd_u: AtdUniforms;
@group(0) @binding(2) var atd_samp: sampler;
@group(1) @binding(0) var<storage, read_write> attr_Cd: array<vec4<f32>>; // @Cd: vec4 (f32x4)
@group(1) @binding(1) var<storage, read_write> attr_P: array<vec3<f32>>; // @P: vec3 (f32x3)
@group(2) @binding(0) var atd_img0: texture_2d<f32>; // input image 0
@group(2) @binding(2) var atd_img2: texture_2d<f32>; // input image 2

var<private> atd_index: u32;
var<private> a_Cd: vec4f;
var<private> a_P: vec3f;

fn atd_fit_vec2f(x: vec2f, omin: vec2f, omax: vec2f, nmin: vec2f, nmax: vec2f) -> vec2f {
    let d = omax - omin;
    let z = d == vec2f(0.0);
    let t = select(clamp((x - omin) / select(d, vec2f(1.0), z), vec2f(0.0), vec2f(1.0)), vec2f(0.5), z);
    return nmin + (nmax - nmin) * t;
}


fn atd_kernel() {
    var l0_uv: vec2f = atd_fit_vec2f((a_P).xz, vec2f(f32((-1i))), vec2f(1.0f), vec2f(0.0f), vec2f(1.0f));
    var l1_c: vec4f = textureSampleLevel(atd_img0, atd_samp, l0_uv, 0.0f);
    var l2_mask: vec4f = textureSampleLevel(atd_img2, atd_samp, l0_uv, 0.0f);
    a_Cd = (l1_c * vec4f((l2_mask).w));
    a_P.y = ((l1_c).x * atd_u.p[0].x);
}

@compute @workgroup_size(256)
fn main(@builtin(global_invocation_id) atd_gid: vec3u, @builtin(num_workgroups) atd_nwg: vec3u) {
    atd_index = atd_gid.x + atd_gid.y * atd_nwg.x * 256u;
    if (atd_index >= atd_header.count) {
        return;
    }
    a_Cd = attr_Cd[atd_index];
    a_P = attr_P[atd_index];
    atd_kernel();
    attr_Cd[atd_index] = a_Cd;
    attr_P[atd_index] = a_P;
}

// Generated by atd-kernel from a Pixels kernel. Do not edit: edit the kernel.

struct AtdUniforms {
    // time, time step, frame, 0
    globals: vec4f,
    // width, height, 1 / width, 1 / height (pixels)
    res: vec4f,
    p: array<vec4f, 2>,
}

// Parameters:
//   p[0] int = ch("size")
//   p[1] float = ch("mix")

@group(0) @binding(0) var<uniform> atd_u: AtdUniforms;
@group(0) @binding(1) var atd_samp: sampler;
@group(1) @binding(0) var atd_img0: texture_2d<f32>; // input image 0
@group(1) @binding(1) var atd_img1: texture_2d<f32>; // input image 1

var<private> atd_ix: i32;
var<private> atd_iy: i32;
var<private> atd_uv: vec2f;
var<private> a_Cd: vec4f;

// PCG3D hash (Jarzynski and Olano 2020).
fn atd_pcg3d(v0: vec3u) -> vec3u {
    var v = v0 * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v = v ^ (v >> vec3u(16u));
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return v;
}

fn atd_hash2(c: vec2i) -> u32 {
    return atd_pcg3d(vec3u(bitcast<vec2u>(c), 0u)).x;
}

fn atd_grad2(h: u32) -> vec2f {
    let a = f32(h & 1u) * 2.0f - 1.0f;
    let b = f32((h >> 1u) & 1u) * 2.0f - 1.0f;
    if ((h & 4u) == 0u) {
        return vec2f(a, b);
    }
    if ((h & 8u) == 0u) {
        return vec2f(a, 0.0f);
    }
    return vec2f(0.0f, b);
}

// Integer division that never faults: x / 0 = x, x / -1 = -x (wrapping).
fn atd_idiv(a: i32, b: i32) -> i32 {
    if (b == 0i) {
        return a;
    }
    if (b == -1i) {
        return 0i - a;
    }
    return a / b;
}

fn atd_imod(a: i32, b: i32) -> i32 {
    if (b == 0i || b == -1i) {
        return 0i;
    }
    return a % b;
}

// 2D simplex noise (Gustavson), about -1..1.
fn atd_simplex2(p: vec2f) -> f32 {
    let s = (p.x + p.y) * 0.3660254f;
    let i = floor(p + vec2f(s));
    let t = (i.x + i.y) * 0.21132487f;
    let x0 = p - (i - vec2f(t));
    let o = select(vec2f(0.0f, 1.0f), vec2f(1.0f, 0.0f), x0.x > x0.y);
    let x1 = x0 - o + vec2f(0.21132487f);
    let x2 = x0 - vec2f(0.57735026f);
    let c = vec2i(i);
    var n = 0.0f;
    let t0 = 0.5f - dot(x0, x0);
    if (t0 > 0.0f) {
        let q = t0 * t0;
        n = n + q * q * dot(atd_grad2(atd_hash2(c)), x0);
    }
    let t1 = 0.5f - dot(x1, x1);
    if (t1 > 0.0f) {
        let q = t1 * t1;
        n = n + q * q * dot(atd_grad2(atd_hash2(c + vec2i(o))), x1);
    }
    let t2 = 0.5f - dot(x2, x2);
    if (t2 > 0.0f) {
        let q = t2 * t2;
        n = n + q * q * dot(atd_grad2(atd_hash2(c + vec2i(1i, 1i))), x2);
    }
    return 70.0f * n;
}


fn atd_kernel() {
    var l0_size: i32 = bitcast<i32>(atd_u.p[0].x);
    var l1_cx: i32 = atd_idiv(atd_ix, l0_size);
    var l2_cy: i32 = atd_idiv(atd_iy, l0_size);
    var l3_check: f32 = select(0.25f, 1.0f, (atd_imod((l1_cx + l2_cy), 2i) == 0i));
    var l4_p: vec2f = ((atd_uv * atd_u.res.xy) / vec2f(64.0f));
    var l5_n: f32 = ((atd_simplex2(vec2f((l4_p).x, ((l4_p).y + atd_u.globals.x))) * 0.5f) + 0.5f);
    var l6_other: vec4f = textureSampleLevel(atd_img1, atd_samp, atd_uv, 0.0f);
    a_Cd = mix(vec4f((l3_check * l5_n), l5_n, l3_check, 1.0f), l6_other, vec4f(atd_u.p[1].x));
    a_Cd.w = 1.0f;
}

struct AtdVsOut {
    @builtin(position) pos: vec4f,
}

// One triangle covering the output.
@vertex
fn vs(@builtin(vertex_index) i: u32) -> AtdVsOut {
    let p = vec2f(f32((i << 1u) & 2u), f32(i & 2u));
    var out: AtdVsOut;
    out.pos = vec4f(p * vec2f(2.0f, -2.0f) + vec2f(-1.0f, 1.0f), 0.0f, 1.0f);
    return out;
}

@fragment
fn fs(v: AtdVsOut) -> @location(0) vec4f {
    atd_ix = i32(floor(v.pos.x));
    atd_iy = i32(floor(v.pos.y));
    atd_uv = v.pos.xy * atd_u.res.zw;
    a_Cd = textureSampleLevel(atd_img0, atd_samp, atd_uv, 0.0f);
    atd_kernel();
    return a_Cd;
}

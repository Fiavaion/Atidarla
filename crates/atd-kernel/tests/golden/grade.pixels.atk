// A colour grade: lift, gamma, gain and a vignette.
vec3 lift = chv("lift", {0, 0, 0});
vec3 gamma = chv("gamma", {1, 1, 1});
vec3 gain = chv("gain", {1, 1, 1});
float vignette = ch("vignette", 0.3, 0, 1);
vec3 c = @Cd.rgb * gain + lift * (1 - @Cd.rgb);
c = pow(max(c, 0), 1 / max(gamma, 0.001));
float d = distance(@P, {0.5, 0.5});
c *= 1 - vignette * smoothstep(0.3, 0.8, d);
@Cd = vec4(c, @Cd.a);

// Generated by atd-kernel from a Points kernel. Do not edit: edit the kernel.

struct AtdUniforms {
    // time, time step, frame, 0
    globals: vec4f,
    // width, height, 1 / width, 1 / height (pixels)
    res: vec4f,
    p: array<vec4f, 1>,
}

// Parameters:
//   p[0] float = ch("freq")

struct AtdHeader {
    count: u32,
    capacity: u32,
}

@group(0) @binding(0) var<storage, read> atd_header: AtdHeader;
@group(0) @binding(1) var<uniform> atd_u: AtdUniforms;
@group(1) @binding(0) var<storage, read_write> attr_N: array<vec3<f32>>; // @N: vec3 (f32x3)
@group(1) @binding(1) var<storage, read> attr_P: array<vec3<f32>>; // @P: vec3 (f32x3)
@group(1) @binding(2) var<storage, read_write> attr_curl: array<vec3<f32>>; // @curl: vec3 (f32x3)
@group(1) @binding(3) var<storage, read_write> attr_d: array<f32>; // @d: float (f32)
@group(1) @binding(4) var<storage, read> attr_id: array<u32>; // @id: int (u32)

var<private> atd_index: u32;
var<private> a_N: vec3f;
var<private> a_P: vec3f;
var<private> a_curl: vec3f;
var<private> a_d: f32;
var<private> a_id: i32;

// PCG3D hash (Jarzynski and Olano 2020).
fn atd_pcg3d(v0: vec3u) -> vec3u {
    var v = v0 * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v = v ^ (v >> vec3u(16u));
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return v;
}

fn atd_u01(h: u32) -> f32 {
    return f32(h >> 8u) * 5.9604645e-8f;
}

fn atd_u01v3(h: vec3u) -> vec3f {
    return vec3f(h >> vec3u(8u)) * 5.9604645e-8f;
}

fn atd_hash2(c: vec2i) -> u32 {
    return atd_pcg3d(vec3u(bitcast<vec2u>(c), 0u)).x;
}

fn atd_hash3(c: vec3i) -> u32 {
    return atd_pcg3d(bitcast<vec3u>(c)).x;
}

fn atd_grad2(h: u32) -> vec2f {
    let a = f32(h & 1u) * 2.0f - 1.0f;
    let b = f32((h >> 1u) & 1u) * 2.0f - 1.0f;
    if ((h & 4u) == 0u) {
        return vec2f(a, b);
    }
    if ((h & 8u) == 0u) {
        return vec2f(a, 0.0f);
    }
    return vec2f(0.0f, b);
}

// The 12 cube-edge gradients of improved Perlin noise (16 slots).
fn atd_grad3(h0: u32) -> vec3f {
    let h = h0 & 15u;
    let su = select(1.0f, -1.0f, (h & 1u) != 0u);
    let sv = select(1.0f, -1.0f, (h & 2u) != 0u);
    var g = vec3f(0.0f);
    if (h < 8u) {
        g.x = su;
    } else {
        g.y = su;
    }
    if (h < 4u) {
        g.y = g.y + sv;
    } else if (h == 12u || h == 14u) {
        g.x = g.x + sv;
    } else {
        g.z = g.z + sv;
    }
    return g;
}

fn atd_length2_vec3f(v: vec3f) -> f32 {
    return dot(v, v);
}

fn atd_smoothstep_f32(lo: f32, hi: f32, x: f32) -> f32 {
    let d = hi - lo;
    let z = d == f32(0.0);
    let t = select(clamp((x - lo) / select(d, f32(1.0), z), f32(0.0), f32(1.0)), step(lo, x), z);
    return t * t * (f32(3.0) - f32(2.0) * t);
}

fn atd_fit_f32(x: f32, omin: f32, omax: f32, nmin: f32, nmax: f32) -> f32 {
    let d = omax - omin;
    let z = d == f32(0.0);
    let t = select(clamp((x - omin) / select(d, f32(1.0), z), f32(0.0), f32(1.0)), f32(0.5), z);
    return nmin + (nmax - nmin) * t;
}

fn atd_fit_vec3f(x: vec3f, omin: vec3f, omax: vec3f, nmin: vec3f, nmax: vec3f) -> vec3f {
    let d = omax - omin;
    let z = d == vec3f(0.0);
    let t = select(clamp((x - omin) / select(d, vec3f(1.0), z), vec3f(0.0), vec3f(1.0)), vec3f(0.5), z);
    return nmin + (nmax - nmin) * t;
}

// Gradient noise, quintic fade, about -1..1.
fn atd_perlin2(p: vec2f) -> f32 {
    let i = floor(p);
    let f = p - i;
    let c = vec2i(i);
    let u = f * f * f * (f * (f * 6.0f - 15.0f) + 10.0f);
    let va = dot(atd_grad2(atd_hash2(c)), f);
    let vb = dot(atd_grad2(atd_hash2(c + vec2i(1i, 0i))), f - vec2f(1.0f, 0.0f));
    let vc = dot(atd_grad2(atd_hash2(c + vec2i(0i, 1i))), f - vec2f(0.0f, 1.0f));
    let vd = dot(atd_grad2(atd_hash2(c + vec2i(1i, 1i))), f - vec2f(1.0f, 1.0f));
    let x0 = va + (vb - va) * u.x;
    let x1 = vc + (vd - vc) * u.x;
    return x0 + (x1 - x0) * u.y;
}

// 3D gradient noise and its analytic gradient: (value, d/dx, d/dy, d/dz).
fn atd_perlin3d(p: vec3f) -> vec4f {
    let i = floor(p);
    let f = p - i;
    let c = vec3i(i);
    let u = f * f * f * (f * (f * 6.0f - 15.0f) + 10.0f);
    let du = 30.0f * f * f * (f * (f - 2.0f) + 1.0f);
    let ga = atd_grad3(atd_hash3(c));
    let gb = atd_grad3(atd_hash3(c + vec3i(1i, 0i, 0i)));
    let gc = atd_grad3(atd_hash3(c + vec3i(0i, 1i, 0i)));
    let gd = atd_grad3(atd_hash3(c + vec3i(1i, 1i, 0i)));
    let ge = atd_grad3(atd_hash3(c + vec3i(0i, 0i, 1i)));
    let gf = atd_grad3(atd_hash3(c + vec3i(1i, 0i, 1i)));
    let gg = atd_grad3(atd_hash3(c + vec3i(0i, 1i, 1i)));
    let gh = atd_grad3(atd_hash3(c + vec3i(1i, 1i, 1i)));
    let va = dot(ga, f);
    let vb = dot(gb, f - vec3f(1.0f, 0.0f, 0.0f));
    let vc = dot(gc, f - vec3f(0.0f, 1.0f, 0.0f));
    let vd = dot(gd, f - vec3f(1.0f, 1.0f, 0.0f));
    let ve = dot(ge, f - vec3f(0.0f, 0.0f, 1.0f));
    let vf = dot(gf, f - vec3f(1.0f, 0.0f, 1.0f));
    let vg = dot(gg, f - vec3f(0.0f, 1.0f, 1.0f));
    let vh = dot(gh, f - vec3f(1.0f, 1.0f, 1.0f));
    let k1 = vb - va;
    let k2 = vc - va;
    let k3 = ve - va;
    let k4 = va - vb - vc + vd;
    let k5 = va - vc - ve + vg;
    let k6 = va - vb - ve + vf;
    let k7 = -va + vb + vc - vd + ve - vf - vg + vh;
    let value = va + u.x * k1 + u.y * k2 + u.z * k3 + u.x * u.y * k4 + u.y * u.z * k5 + u.z * u.x * k6 + u.x * u.y * u.z * k7;
    let g = ga + u.x * (gb - ga) + u.y * (gc - ga) + u.z * (ge - ga) + u.x * u.y * (ga - gb - gc + gd) + u.y * u.z * (ga - gc - ge + gg) + u.z * u.x * (ga - gb - ge + gf) + u.x * u.y * u.z * (-ga + gb + gc - gd + ge - gf - gg + gh);
    let d = du * vec3f(k1 + u.y * k4 + u.z * k6 + u.y * u.z * k7, k2 + u.z * k5 + u.x * k4 + u.z * u.x * k7, k3 + u.x * k6 + u.y * k5 + u.x * u.y * k7);
    return vec4f(value, g + d);
}

fn atd_perlin3(p: vec3f) -> f32 {
    return atd_perlin3d(p).x;
}

// 2D simplex noise (Gustavson), about -1..1.
fn atd_simplex2(p: vec2f) -> f32 {
    let s = (p.x + p.y) * 0.3660254f;
    let i = floor(p + vec2f(s));
    let t = (i.x + i.y) * 0.21132487f;
    let x0 = p - (i - vec2f(t));
    let o = select(vec2f(0.0f, 1.0f), vec2f(1.0f, 0.0f), x0.x > x0.y);
    let x1 = x0 - o + vec2f(0.21132487f);
    let x2 = x0 - vec2f(0.57735026f);
    let c = vec2i(i);
    var n = 0.0f;
    let t0 = 0.5f - dot(x0, x0);
    if (t0 > 0.0f) {
        let q = t0 * t0;
        n = n + q * q * dot(atd_grad2(atd_hash2(c)), x0);
    }
    let t1 = 0.5f - dot(x1, x1);
    if (t1 > 0.0f) {
        let q = t1 * t1;
        n = n + q * q * dot(atd_grad2(atd_hash2(c + vec2i(o))), x1);
    }
    let t2 = 0.5f - dot(x2, x2);
    if (t2 > 0.0f) {
        let q = t2 * t2;
        n = n + q * q * dot(atd_grad2(atd_hash2(c + vec2i(1i, 1i))), x2);
    }
    return 70.0f * n;
}

// 3D simplex noise (Gustavson), about -1..1.
fn atd_simplex3(p: vec3f) -> f32 {
    let s = (p.x + p.y + p.z) * 0.33333334f;
    let i = floor(p + vec3f(s));
    let t = (i.x + i.y + i.z) * 0.16666667f;
    let x0 = p - (i - vec3f(t));
    let g = step(x0.yzx, x0.xyz);
    let l = vec3f(1.0f) - g;
    let i1 = min(g.xyz, l.zxy);
    let i2 = max(g.xyz, l.zxy);
    let x1 = x0 - i1 + vec3f(0.16666667f);
    let x2 = x0 - i2 + vec3f(0.33333334f);
    let x3 = x0 - vec3f(0.5f);
    let c = vec3i(i);
    var n = 0.0f;
    let t0 = 0.5f - dot(x0, x0);
    if (t0 > 0.0f) {
        let q = t0 * t0;
        n = n + q * q * dot(atd_grad3(atd_hash3(c)), x0);
    }
    let t1 = 0.5f - dot(x1, x1);
    if (t1 > 0.0f) {
        let q = t1 * t1;
        n = n + q * q * dot(atd_grad3(atd_hash3(c + vec3i(i1))), x1);
    }
    let t2 = 0.5f - dot(x2, x2);
    if (t2 > 0.0f) {
        let q = t2 * t2;
        n = n + q * q * dot(atd_grad3(atd_hash3(c + vec3i(i2))), x2);
    }
    let t3 = 0.5f - dot(x3, x3);
    if (t3 > 0.0f) {
        let q = t3 * t3;
        n = n + q * q * dot(atd_grad3(atd_hash3(c + vec3i(1i, 1i, 1i))), x3);
    }
    return 76.0f * n;
}

// Distance to the nearest feature point (F1), one point per cell.
fn atd_worley2(p: vec2f) -> f32 {
    let i = floor(p);
    let f = p - i;
    let c = vec2i(i);
    var d = 8.0f;
    for (var y = -1i; y <= 1i; y++) {
        for (var x = -1i; x <= 1i; x++) {
            let o = vec2i(x, y);
            let h = atd_pcg3d(vec3u(bitcast<vec2u>(c + o), 0u));
            let r = vec2f(o) + atd_u01v3(h).xy - f;
            d = min(d, dot(r, r));
        }
    }
    return sqrt(d);
}

fn atd_worley3(p: vec3f) -> f32 {
    let i = floor(p);
    let f = p - i;
    let c = vec3i(i);
    var d = 8.0f;
    for (var z = -1i; z <= 1i; z++) {
        for (var y = -1i; y <= 1i; y++) {
            for (var x = -1i; x <= 1i; x++) {
                let o = vec3i(x, y, z);
                let h = atd_pcg3d(bitcast<vec3u>(c + o));
                let r = vec3f(o) + atd_u01v3(h) - f;
                d = min(d, dot(r, r));
            }
        }
    }
    return sqrt(d);
}

// Curl of the vector potential (perlin(p), perlin(p + o1), perlin(p + o2)).
fn atd_curlnoise(p: vec3f) -> vec3f {
    let a = atd_perlin3d(p);
    let b = atd_perlin3d(p + vec3f(31.416f, -47.853f, 12.679f));
    let c = atd_perlin3d(p + vec3f(-233.17f, 113.51f, 71.93f));
    return vec3f(c.z - b.w, a.w - c.y, b.y - a.z);
}

fn atd_rand_i(x: i32) -> f32 {
    return atd_u01(atd_pcg3d(vec3u(bitcast<u32>(x), 0u, 0u)).x);
}

fn atd_rand_f(x: f32) -> f32 {
    return atd_u01(atd_pcg3d(vec3u(bitcast<u32>(x), 0u, 0u)).x);
}

fn atd_rand_v2(x: vec2f) -> f32 {
    return atd_u01(atd_pcg3d(vec3u(bitcast<vec2u>(x), 0u)).x);
}

fn atd_rand_v3(x: vec3f) -> f32 {
    return atd_u01(atd_pcg3d(bitcast<vec3u>(x)).x);
}


fn atd_kernel() {
    var l0_p: vec3f = (a_P * vec3f(atd_u.p[0].x));
    var l1_a: f32 = (atd_perlin3(l0_p) + atd_perlin2((l0_p).xy));
    var l2_b: f32 = (atd_simplex3(l0_p) + atd_simplex2((l0_p).xz));
    var l3_c: f32 = (atd_worley3(l0_p) + atd_worley2((l0_p).yz));
    a_curl = atd_curlnoise(l0_p);
    var l4_r: f32 = (((atd_rand_i(a_id) + atd_rand_f((f32(i32(atd_index)) * 0.5f))) + atd_rand_v2((l0_p).xy)) + atd_rand_v3(l0_p));
    var l5_m: f32 = (((atd_fit_f32(l1_a, f32((-1i)), 1.0f, 0.0f, 1.0f) + atd_fit_f32(l2_b, 0.0f, 1.0f, 2.0f, 3.0f)) + atd_smoothstep_f32(0.0f, 1.0f, l3_c)) + atd_smoothstep_f32(0.0f, 1.0f, l4_r));
    a_N = ((atd_fit_vec3f(l0_p, vec3f(f32((-1i)), f32((-1i)), f32((-1i))), vec3f(1.0f, 1.0f, 1.0f), vec3f(0.0f), vec3f(1.0f)) * vec3f(min(max(l5_m, 0.0f), 1.0f))) + mix(l0_p, (-l0_p), vec3f(0.5f)));
    a_d = (((atd_length2_vec3f(l0_p) + atd_length2_vec3f((l0_p) - (a_N))) + distance(l0_p, a_N)) + dot(l0_p, a_N));
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) atd_gid: vec3u, @builtin(num_workgroups) atd_nwg: vec3u) {
    atd_index = atd_gid.x + atd_gid.y * atd_nwg.x * 64u;
    if (atd_index >= atd_header.count) {
        return;
    }
    a_N = attr_N[atd_index];
    a_P = attr_P[atd_index];
    a_curl = attr_curl[atd_index];
    a_d = attr_d[atd_index];
    a_id = i32(attr_id[atd_index]);
    atd_kernel();
    attr_N[atd_index] = a_N;
    attr_curl[atd_index] = a_curl;
    attr_d[atd_index] = a_d;
}

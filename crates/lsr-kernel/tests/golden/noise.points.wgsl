// Generated by lsr-kernel from a Points kernel. Do not edit: edit the kernel.

struct LsrUniforms {
    // time, time step, frame, 0
    globals: vec4f,
    // width, height, 1 / width, 1 / height (pixels)
    res: vec4f,
    p: array<vec4f, 1>,
}

// Parameters:
//   p[0] float = ch("freq")

struct LsrHeader {
    count: u32,
    capacity: u32,
}

@group(0) @binding(0) var<storage, read> lsr_header: LsrHeader;
@group(0) @binding(1) var<uniform> lsr_u: LsrUniforms;
@group(1) @binding(0) var<storage, read_write> attr_N: array<vec3<f32>>; // @N: vec3 (f32x3)
@group(1) @binding(1) var<storage, read> attr_P: array<vec3<f32>>; // @P: vec3 (f32x3)
@group(1) @binding(2) var<storage, read_write> attr_curl: array<vec3<f32>>; // @curl: vec3 (f32x3)
@group(1) @binding(3) var<storage, read_write> attr_d: array<f32>; // @d: float (f32)
@group(1) @binding(4) var<storage, read> attr_id: array<u32>; // @id: int (u32)

var<private> lsr_index: u32;
var<private> a_N: vec3f;
var<private> a_P: vec3f;
var<private> a_curl: vec3f;
var<private> a_d: f32;
var<private> a_id: i32;

// PCG3D hash (Jarzynski and Olano 2020).
fn lsr_pcg3d(v0: vec3u) -> vec3u {
    var v = v0 * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v = v ^ (v >> vec3u(16u));
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return v;
}

fn lsr_u01(h: u32) -> f32 {
    return f32(h >> 8u) * 5.9604645e-8f;
}

fn lsr_u01v3(h: vec3u) -> vec3f {
    return vec3f(h >> vec3u(8u)) * 5.9604645e-8f;
}

fn lsr_hash2(c: vec2i) -> u32 {
    return lsr_pcg3d(vec3u(bitcast<vec2u>(c), 0u)).x;
}

fn lsr_ihash3(c: vec3i) -> u32 {
    return lsr_pcg3d(bitcast<vec3u>(c)).x;
}

fn lsr_grad2(h: u32) -> vec2f {
    let a = f32(h & 1u) * 2.0f - 1.0f;
    let b = f32((h >> 1u) & 1u) * 2.0f - 1.0f;
    if ((h & 4u) == 0u) {
        return vec2f(a, b);
    }
    if ((h & 8u) == 0u) {
        return vec2f(a, 0.0f);
    }
    return vec2f(0.0f, b);
}

// The 12 cube-edge gradients of improved Perlin noise (16 slots).
fn lsr_grad3(h0: u32) -> vec3f {
    let h = h0 & 15u;
    let su = select(1.0f, -1.0f, (h & 1u) != 0u);
    let sv = select(1.0f, -1.0f, (h & 2u) != 0u);
    var g = vec3f(0.0f);
    if (h < 8u) {
        g.x = su;
    } else {
        g.y = su;
    }
    if (h < 4u) {
        g.y = g.y + sv;
    } else if (h == 12u || h == 14u) {
        g.x = g.x + sv;
    } else {
        g.z = g.z + sv;
    }
    return g;
}

fn lsr_length2_vec3f(v: vec3f) -> f32 {
    return dot(v, v);
}

fn lsr_smoothstep_f32(lo: f32, hi: f32, x: f32) -> f32 {
    let d = hi - lo;
    let z = d == f32(0.0);
    let t = select(clamp((x - lo) / select(d, f32(1.0), z), f32(0.0), f32(1.0)), step(lo, x), z);
    return t * t * (f32(3.0) - f32(2.0) * t);
}

fn lsr_fit_f32(x: f32, omin: f32, omax: f32, nmin: f32, nmax: f32) -> f32 {
    let d = omax - omin;
    let z = d == f32(0.0);
    let t = select(clamp((x - omin) / select(d, f32(1.0), z), f32(0.0), f32(1.0)), f32(0.5), z);
    return nmin + (nmax - nmin) * t;
}

fn lsr_fit_vec3f(x: vec3f, omin: vec3f, omax: vec3f, nmin: vec3f, nmax: vec3f) -> vec3f {
    let d = omax - omin;
    let z = d == vec3f(0.0);
    let t = select(clamp((x - omin) / select(d, vec3f(1.0), z), vec3f(0.0), vec3f(1.0)), vec3f(0.5), z);
    return nmin + (nmax - nmin) * t;
}

// Gradient noise, quintic fade, about -1..1.
fn lsr_perlin2(p: vec2f) -> f32 {
    let i = floor(p);
    let f = p - i;
    let c = vec2i(i);
    let u = f * f * f * (f * (f * 6.0f - 15.0f) + 10.0f);
    let va = dot(lsr_grad2(lsr_hash2(c)), f);
    let vb = dot(lsr_grad2(lsr_hash2(c + vec2i(1i, 0i))), f - vec2f(1.0f, 0.0f));
    let vc = dot(lsr_grad2(lsr_hash2(c + vec2i(0i, 1i))), f - vec2f(0.0f, 1.0f));
    let vd = dot(lsr_grad2(lsr_hash2(c + vec2i(1i, 1i))), f - vec2f(1.0f, 1.0f));
    let x0 = va + (vb - va) * u.x;
    let x1 = vc + (vd - vc) * u.x;
    return x0 + (x1 - x0) * u.y;
}

// 3D gradient noise and its analytic gradient: (value, d/dx, d/dy, d/dz).
fn lsr_perlin3d(p: vec3f) -> vec4f {
    let i = floor(p);
    let f = p - i;
    let c = vec3i(i);
    let u = f * f * f * (f * (f * 6.0f - 15.0f) + 10.0f);
    let du = 30.0f * f * f * (f * (f - 2.0f) + 1.0f);
    let ga = lsr_grad3(lsr_ihash3(c));
    let gb = lsr_grad3(lsr_ihash3(c + vec3i(1i, 0i, 0i)));
    let gc = lsr_grad3(lsr_ihash3(c + vec3i(0i, 1i, 0i)));
    let gd = lsr_grad3(lsr_ihash3(c + vec3i(1i, 1i, 0i)));
    let ge = lsr_grad3(lsr_ihash3(c + vec3i(0i, 0i, 1i)));
    let gf = lsr_grad3(lsr_ihash3(c + vec3i(1i, 0i, 1i)));
    let gg = lsr_grad3(lsr_ihash3(c + vec3i(0i, 1i, 1i)));
    let gh = lsr_grad3(lsr_ihash3(c + vec3i(1i, 1i, 1i)));
    let va = dot(ga, f);
    let vb = dot(gb, f - vec3f(1.0f, 0.0f, 0.0f));
    let vc = dot(gc, f - vec3f(0.0f, 1.0f, 0.0f));
    let vd = dot(gd, f - vec3f(1.0f, 1.0f, 0.0f));
    let ve = dot(ge, f - vec3f(0.0f, 0.0f, 1.0f));
    let vf = dot(gf, f - vec3f(1.0f, 0.0f, 1.0f));
    let vg = dot(gg, f - vec3f(0.0f, 1.0f, 1.0f));
    let vh = dot(gh, f - vec3f(1.0f, 1.0f, 1.0f));
    let k1 = vb - va;
    let k2 = vc - va;
    let k3 = ve - va;
    let k4 = va - vb - vc + vd;
    let k5 = va - vc - ve + vg;
    let k6 = va - vb - ve + vf;
    let k7 = -va + vb + vc - vd + ve - vf - vg + vh;
    let value = va + u.x * k1 + u.y * k2 + u.z * k3 + u.x * u.y * k4 + u.y * u.z * k5 + u.z * u.x * k6 + u.x * u.y * u.z * k7;
    let g = ga + u.x * (gb - ga) + u.y * (gc - ga) + u.z * (ge - ga) + u.x * u.y * (ga - gb - gc + gd) + u.y * u.z * (ga - gc - ge + gg) + u.z * u.x * (ga - gb - ge + gf) + u.x * u.y * u.z * (-ga + gb + gc - gd + ge - gf - gg + gh);
    let d = du * vec3f(k1 + u.y * k4 + u.z * k6 + u.y * u.z * k7, k2 + u.z * k5 + u.x * k4 + u.z * u.x * k7, k3 + u.x * k6 + u.y * k5 + u.x * u.y * k7);
    return vec4f(value, g + d);
}

fn lsr_perlin3(p: vec3f) -> f32 {
    return lsr_perlin3d(p).x;
}

// 2D simplex noise (Gustavson), about -1..1.
fn lsr_simplex2(p: vec2f) -> f32 {
    let s = (p.x + p.y) * 0.3660254f;
    let i = floor(p + vec2f(s));
    let t = (i.x + i.y) * 0.21132487f;
    let x0 = p - (i - vec2f(t));
    let o = select(vec2f(0.0f, 1.0f), vec2f(1.0f, 0.0f), x0.x > x0.y);
    let x1 = x0 - o + vec2f(0.21132487f);
    let x2 = x0 - vec2f(0.57735026f);
    let c = vec2i(i);
    var n = 0.0f;
    let t0 = 0.5f - dot(x0, x0);
    if (t0 > 0.0f) {
        let q = t0 * t0;
        n = n + q * q * dot(lsr_grad2(lsr_hash2(c)), x0);
    }
    let t1 = 0.5f - dot(x1, x1);
    if (t1 > 0.0f) {
        let q = t1 * t1;
        n = n + q * q * dot(lsr_grad2(lsr_hash2(c + vec2i(o))), x1);
    }
    let t2 = 0.5f - dot(x2, x2);
    if (t2 > 0.0f) {
        let q = t2 * t2;
        n = n + q * q * dot(lsr_grad2(lsr_hash2(c + vec2i(1i, 1i))), x2);
    }
    return 70.0f * n;
}

// 3D simplex noise (Gustavson), about -1..1.
fn lsr_simplex3(p: vec3f) -> f32 {
    let s = (p.x + p.y + p.z) * 0.33333334f;
    let i = floor(p + vec3f(s));
    let t = (i.x + i.y + i.z) * 0.16666667f;
    let x0 = p - (i - vec3f(t));
    let g = step(x0.yzx, x0.xyz);
    let l = vec3f(1.0f) - g;
    let i1 = min(g.xyz, l.zxy);
    let i2 = max(g.xyz, l.zxy);
    let x1 = x0 - i1 + vec3f(0.16666667f);
    let x2 = x0 - i2 + vec3f(0.33333334f);
    let x3 = x0 - vec3f(0.5f);
    let c = vec3i(i);
    var n = 0.0f;
    let t0 = 0.5f - dot(x0, x0);
    if (t0 > 0.0f) {
        let q = t0 * t0;
        n = n + q * q * dot(lsr_grad3(lsr_ihash3(c)), x0);
    }
    let t1 = 0.5f - dot(x1, x1);
    if (t1 > 0.0f) {
        let q = t1 * t1;
        n = n + q * q * dot(lsr_grad3(lsr_ihash3(c + vec3i(i1))), x1);
    }
    let t2 = 0.5f - dot(x2, x2);
    if (t2 > 0.0f) {
        let q = t2 * t2;
        n = n + q * q * dot(lsr_grad3(lsr_ihash3(c + vec3i(i2))), x2);
    }
    let t3 = 0.5f - dot(x3, x3);
    if (t3 > 0.0f) {
        let q = t3 * t3;
        n = n + q * q * dot(lsr_grad3(lsr_ihash3(c + vec3i(1i, 1i, 1i))), x3);
    }
    return 76.0f * n;
}

// Distance to the nearest feature point (F1), one point per cell.
fn lsr_worley2(p: vec2f) -> f32 {
    let i = floor(p);
    let f = p - i;
    let c = vec2i(i);
    var d = 8.0f;
    for (var y = -1i; y <= 1i; y++) {
        for (var x = -1i; x <= 1i; x++) {
            let o = vec2i(x, y);
            let h = lsr_pcg3d(vec3u(bitcast<vec2u>(c + o), 0u));
            let r = vec2f(o) + lsr_u01v3(h).xy - f;
            d = min(d, dot(r, r));
        }
    }
    return sqrt(d);
}

fn lsr_worley3(p: vec3f) -> f32 {
    let i = floor(p);
    let f = p - i;
    let c = vec3i(i);
    var d = 8.0f;
    for (var z = -1i; z <= 1i; z++) {
        for (var y = -1i; y <= 1i; y++) {
            for (var x = -1i; x <= 1i; x++) {
                let o = vec3i(x, y, z);
                let h = lsr_pcg3d(bitcast<vec3u>(c + o));
                let r = vec3f(o) + lsr_u01v3(h) - f;
                d = min(d, dot(r, r));
            }
        }
    }
    return sqrt(d);
}


fn lsr_hash(x: u32) -> u32 {
    let s = x * 747796405u + 2891336453u;
    let w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

fn lsr_hash3(v0: vec3u) -> vec3u {
    var v = v0 * 1664525u + vec3u(1013904223u);
    v.x = v.x + v.y * v.z;
    v.y = v.y + v.z * v.x;
    v.z = v.z + v.x * v.y;
    v = v ^ (v >> vec3u(16u));
    v.x = v.x + v.y * v.z;
    v.y = v.y + v.z * v.x;
    v.z = v.z + v.x * v.y;
    return v;
}

fn lsr_unit(h: u32) -> f32 {
    // 24 bits: exactly representable, in [0, 1).
    return f32(h >> 8u) * (1.0 / 16777216.0);
}

fn lsr_rand(seed: u32, i: u32) -> f32 {
    return lsr_unit(lsr_hash(i ^ lsr_hash(seed)));
}

fn lsr_rand3(seed: u32, i: u32) -> vec3f {
    let h = lsr_hash3(vec3u(i, seed, i ^ 0x9e3779b9u));
    return vec3f(lsr_unit(h.x), lsr_unit(h.y), lsr_unit(h.z));
}

fn lsr_in_sphere(seed: u32, i: u32) -> vec3f {
    let r = lsr_rand3(seed, i);
    // Direction from two uniforms, radius from the cube root of the third.
    let z = r.x * 2.0 - 1.0;
    let a = r.y * 6.28318530718;
    let s = sqrt(max(0.0, 1.0 - z * z));
    return vec3f(s * cos(a), s * sin(a), z) * pow(r.z, 1.0 / 3.0);
}

fn lsr_grad(c: vec3i, seed: u32) -> vec3f {
    let h = lsr_hash3(bitcast<vec3u>(c) ^ vec3u(seed, seed * 3u + 1u, seed * 7u + 2u));
    // Components uniform in [-1, 1].
    return vec3f(h & vec3u(0xffffu)) * (2.0 / 65535.0) - vec3f(1.0);
}

fn lsr_gnoise(p: vec3f, seed: u32) -> vec4f {
    let cell = floor(p);
    let c = vec3i(cell);
    let f = p - cell;
    // Quintic fade and its derivative.
    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    let du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
    // Corner gradients, x fastest: 000 100 010 110 001 101 011 111.
    let g0 = lsr_grad(c, seed);
    let g1 = lsr_grad(c + vec3i(1, 0, 0), seed);
    let g2 = lsr_grad(c + vec3i(0, 1, 0), seed);
    let g3 = lsr_grad(c + vec3i(1, 1, 0), seed);
    let g4 = lsr_grad(c + vec3i(0, 0, 1), seed);
    let g5 = lsr_grad(c + vec3i(1, 0, 1), seed);
    let g6 = lsr_grad(c + vec3i(0, 1, 1), seed);
    let g7 = lsr_grad(c + vec3i(1, 1, 1), seed);
    // Corner values: the gradient dotted with the offset to the corner.
    let n0 = dot(g0, f);
    let n1 = dot(g1, f - vec3f(1.0, 0.0, 0.0));
    let n2 = dot(g2, f - vec3f(0.0, 1.0, 0.0));
    let n3 = dot(g3, f - vec3f(1.0, 1.0, 0.0));
    let n4 = dot(g4, f - vec3f(0.0, 0.0, 1.0));
    let n5 = dot(g5, f - vec3f(1.0, 0.0, 1.0));
    let n6 = dot(g6, f - vec3f(0.0, 1.0, 1.0));
    let n7 = dot(g7, f - vec3f(1.0, 1.0, 1.0));
    // Trilinear interpolation written as a polynomial in u:
    // n = k0 + k1 ux + k2 uy + k3 uz + k4 ux uy + k5 uy uz + k6 ux uz + k7 ux uy uz.
    let k1 = n1 - n0;
    let k2 = n2 - n0;
    let k3 = n4 - n0;
    let k4 = n0 - n1 - n2 + n3;
    let k5 = n0 - n2 - n4 + n6;
    let k6 = n0 - n1 - n4 + n5;
    let k7 = -n0 + n1 + n2 - n3 + n4 - n5 - n6 + n7;
    let value = n0 + k1 * u.x + k2 * u.y + k3 * u.z + k4 * u.x * u.y + k5 * u.y * u.z
        + k6 * u.x * u.z + k7 * u.x * u.y * u.z;
    // The same polynomial over the corner gradients (each corner value's
    // own derivative) ...
    let gk1 = g1 - g0;
    let gk2 = g2 - g0;
    let gk3 = g4 - g0;
    let gk4 = g0 - g1 - g2 + g3;
    let gk5 = g0 - g2 - g4 + g6;
    let gk6 = g0 - g1 - g4 + g5;
    let gk7 = -g0 + g1 + g2 - g3 + g4 - g5 - g6 + g7;
    var grad = g0 + gk1 * u.x + gk2 * u.y + gk3 * u.z + gk4 * u.x * u.y + gk5 * u.y * u.z
        + gk6 * u.x * u.z + gk7 * u.x * u.y * u.z;
    // ... plus the chain rule through the fade.
    grad = grad + du * vec3f(
        k1 + k4 * u.y + k6 * u.z + k7 * u.y * u.z,
        k2 + k4 * u.x + k5 * u.z + k7 * u.x * u.z,
        k3 + k5 * u.y + k6 * u.x + k7 * u.x * u.y,
    );
    return vec4f(value, grad);
}

fn lsr_curl(p: vec3f, seed: u32) -> vec3f {
    let a = lsr_gnoise(p, seed).yzw;
    let b = lsr_gnoise(p + vec3f(31.416, 47.853, 12.679), seed + 1u).yzw;
    let c = lsr_gnoise(p + vec3f(-59.207, 23.114, -71.931), seed + 2u).yzw;
    // Potential (a, b, c): curl = (dc/dy - db/dz, da/dz - dc/dx, db/dx - da/dy).
    return vec3f(c.y - b.z, a.z - c.x, b.x - a.y);
}
// The engine's curl noise (seed 0), the same code `pnt.noise` runs.
    fn lsr_curlnoise(p: vec3f) -> vec3f {
        return lsr_curl(p, 0u);
    }
    
fn lsr_rand_i(x: i32) -> f32 {
    return lsr_u01(lsr_pcg3d(vec3u(bitcast<u32>(x), 0u, 0u)).x);
}

fn lsr_rand_f(x: f32) -> f32 {
    return lsr_u01(lsr_pcg3d(vec3u(bitcast<u32>(x), 0u, 0u)).x);
}

fn lsr_rand_v2(x: vec2f) -> f32 {
    return lsr_u01(lsr_pcg3d(vec3u(bitcast<vec2u>(x), 0u)).x);
}

fn lsr_rand_v3(x: vec3f) -> f32 {
    return lsr_u01(lsr_pcg3d(bitcast<vec3u>(x)).x);
}


fn lsr_kernel() {
    var l0_p: vec3f = (a_P * vec3f(lsr_u.p[0].x));
    var l1_a: f32 = (lsr_perlin3(l0_p) + lsr_perlin2((l0_p).xy));
    var l2_b: f32 = (lsr_simplex3(l0_p) + lsr_simplex2((l0_p).xz));
    var l3_c: f32 = (lsr_worley3(l0_p) + lsr_worley2((l0_p).yz));
    a_curl = lsr_curlnoise(l0_p);
    var l4_r: f32 = (((lsr_rand_i(a_id) + lsr_rand_f((f32(i32(lsr_index)) * 0.5f))) + lsr_rand_v2((l0_p).xy)) + lsr_rand_v3(l0_p));
    var l5_m: f32 = (((lsr_fit_f32(l1_a, f32((-1i)), 1.0f, 0.0f, 1.0f) + lsr_fit_f32(l2_b, 0.0f, 1.0f, 2.0f, 3.0f)) + lsr_smoothstep_f32(0.0f, 1.0f, l3_c)) + lsr_smoothstep_f32(0.0f, 1.0f, l4_r));
    a_N = ((lsr_fit_vec3f(l0_p, vec3f(f32((-1i)), f32((-1i)), f32((-1i))), vec3f(1.0f, 1.0f, 1.0f), vec3f(0.0f), vec3f(1.0f)) * vec3f(min(max(l5_m, 0.0f), 1.0f))) + mix(l0_p, (-l0_p), vec3f(0.5f)));
    a_d = (((lsr_length2_vec3f(l0_p) + lsr_length2_vec3f((l0_p) - (a_N))) + distance(l0_p, a_N)) + dot(l0_p, a_N));
}

@compute @workgroup_size(256)
fn main(@builtin(global_invocation_id) lsr_gid: vec3u, @builtin(num_workgroups) lsr_nwg: vec3u) {
    lsr_index = lsr_gid.x + lsr_gid.y * lsr_nwg.x * 256u;
    if (lsr_index >= lsr_header.count) {
        return;
    }
    a_N = attr_N[lsr_index];
    a_P = attr_P[lsr_index];
    a_curl = attr_curl[lsr_index];
    a_d = attr_d[lsr_index];
    a_id = i32(attr_id[lsr_index]);
    lsr_kernel();
    attr_N[lsr_index] = a_N;
    attr_curl[lsr_index] = a_curl;
    attr_d[lsr_index] = a_d;
}

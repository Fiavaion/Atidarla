// Generated by lsr-kernel from a Pixels kernel. Do not edit: edit the kernel.

struct LsrUniforms {
    // time, time step, frame, 0
    globals: vec4f,
    // width, height, 1 / width, 1 / height (pixels)
    res: vec4f,
    p: array<vec4f, 4>,
}

// Parameters:
//   p[0] vec3 = ch("lift")
//   p[1] vec3 = ch("gamma")
//   p[2] vec3 = ch("gain")
//   p[3] float = ch("vignette")

@group(0) @binding(0) var<uniform> lsr_u: LsrUniforms;
@group(0) @binding(1) var lsr_samp: sampler;
@group(1) @binding(0) var lsr_img0: texture_2d<f32>; // input image 0

var<private> lsr_ix: i32;
var<private> lsr_iy: i32;
var<private> lsr_uv: vec2f;
var<private> a_Cd: vec4f;

fn lsr_smoothstep_f32(lo: f32, hi: f32, x: f32) -> f32 {
    let d = hi - lo;
    let z = d == f32(0.0);
    let t = select(clamp((x - lo) / select(d, f32(1.0), z), f32(0.0), f32(1.0)), step(lo, x), z);
    return t * t * (f32(3.0) - f32(2.0) * t);
}


fn lsr_kernel() {
    var l0_lift: vec3f = lsr_u.p[0].xyz;
    var l1_gamma: vec3f = lsr_u.p[1].xyz;
    var l2_gain: vec3f = lsr_u.p[2].xyz;
    var l3_vignette: f32 = lsr_u.p[3].x;
    var l4_c: vec3f = (((a_Cd).xyz * l2_gain) + (l0_lift * (vec3f(1.0f) - (a_Cd).xyz)));
    l4_c = pow(max(l4_c, vec3f(0.0f)), (vec3f(1.0f) / max(l1_gamma, vec3f(0.001f))));
    var l5_d: f32 = distance(lsr_uv, vec2f(0.5f, 0.5f));
    l4_c = (l4_c * vec3f((1.0f - (l3_vignette * lsr_smoothstep_f32(0.3f, 0.8f, l5_d)))));
    a_Cd = vec4f(l4_c, (a_Cd).w);
}

struct LsrVsOut {
    @builtin(position) pos: vec4f,
}

// One triangle covering the output.
@vertex
fn vs(@builtin(vertex_index) i: u32) -> LsrVsOut {
    let p = vec2f(f32((i << 1u) & 2u), f32(i & 2u));
    var out: LsrVsOut;
    out.pos = vec4f(p * vec2f(2.0f, -2.0f) + vec2f(-1.0f, 1.0f), 0.0f, 1.0f);
    return out;
}

@fragment
fn fs(v: LsrVsOut) -> @location(0) vec4f {
    lsr_ix = i32(floor(v.pos.x));
    lsr_iy = i32(floor(v.pos.y));
    lsr_uv = v.pos.xy * lsr_u.res.zw;
    a_Cd = textureSampleLevel(lsr_img0, lsr_samp, lsr_uv, 0.0f);
    lsr_kernel();
    return a_Cd;
}

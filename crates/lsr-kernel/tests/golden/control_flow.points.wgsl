// Generated by lsr-kernel from a Points kernel. Do not edit: edit the kernel.

struct LsrUniforms {
    // time, time step, frame, 0
    globals: vec4f,
    // width, height, 1 / width, 1 / height (pixels)
    res: vec4f,
    p: array<vec4f, 1>,
}

// Parameters:
//   p[0] int = ch("octaves")

struct LsrHeader {
    count: u32,
    capacity: u32,
}

@group(0) @binding(0) var<storage, read> lsr_header: LsrHeader;
@group(0) @binding(1) var<uniform> lsr_u: LsrUniforms;
@group(1) @binding(0) var<storage, read_write> attr_N: array<vec3<f32>>; // @N: vec3 (f32x3)
@group(1) @binding(1) var<storage, read_write> attr_P: array<vec3<f32>>; // @P: vec3 (f32x3)

var<private> lsr_index: u32;
var<private> a_N: vec3f;
var<private> a_P: vec3f;

// Integer division that never faults: x / 0 = x, x / -1 = -x (wrapping).
fn lsr_idiv(a: i32, b: i32) -> i32 {
    if (b == 0i) {
        return a;
    }
    if (b == -1i) {
        return 0i - a;
    }
    return a / b;
}

fn lsr_imod(a: i32, b: i32) -> i32 {
    if (b == 0i || b == -1i) {
        return 0i;
    }
    return a % b;
}

fn lsr_normalize_vec3f(v: vec3f) -> vec3f {
    let l = length(v);
    return select(vec3f(), v / l, l > 0.0);
}


fn u_wave(p_x: f32, p_octaves: i32) -> f32 {
    var l0_x: f32 = p_x;
    var l1_octaves: i32 = p_octaves;
    var l2_sum: f32 = 0.0f;
    var l3_amp: f32 = 1.0f;
    {
        var l4_k: i32 = 0i;
        let lsr_end0: i32 = l1_octaves;
        var lsr_trip0: u32 = 0u;
        loop {
            if (!(l4_k < lsr_end0)) {
                break;
            }
            l2_sum = (l2_sum + (sin((l0_x * f32((1i << (u32(l4_k) & 31u))))) * l3_amp));
            l3_amp = (l3_amp * 0.5f);
            if ((l3_amp < 0.01f)) {
                break;
            }
            continuing {
                l4_k = l4_k + 1i;
                lsr_trip0 = lsr_trip0 + 1u;
                break if lsr_trip0 >= 1048576u;
            }
        }
    }
    return l2_sum;
}

fn u_bucket(p_n: i32, p_size: i32) -> i32 {
    var l0_n: i32 = p_n;
    var l1_size: i32 = p_size;
    if ((l1_size <= 0i)) {
        return 0i;
    }
    return (lsr_idiv(l0_n, l1_size) + lsr_imod(l0_n, l1_size));
}

fn u_unused() {
    return;
}

fn lsr_kernel() {
    var l0_n: i32 = bitcast<i32>(lsr_u.p[0].x);
    var l1_b: i32 = u_bucket(i32(lsr_index), 7i);
    var l2_h: f32 = u_wave(((a_P).x + f32(l1_b)), l0_n);
    {
        var l3_i: i32 = 10i;
        let lsr_end1: i32 = 0i;
        var lsr_trip1: u32 = 0u;
        loop {
            if (!(l3_i >= lsr_end1)) {
                break;
            }
            if ((l3_i == 4i)) {
                continue;
            }
            l2_h = (l2_h + (f32(l3_i) * 0.001f));
            continuing {
                l3_i = l3_i + (-2i);
                lsr_trip1 = lsr_trip1 + 1u;
                break if lsr_trip1 >= 1048576u;
            }
        }
    }
    a_P.y = select((-l2_h), l2_h, (i32(lsr_header.count) > 0i));
    a_N = lsr_normalize_vec3f(vec3f(0.0f, 1.0f, l2_h));
    if ((((lsr_imod(i32(lsr_index), 2i) == 0i) && (!(l2_h > 1.0f))) || false)) {
        a_P.z = (f32(((~i32(lsr_index)) & 255i)) / 255.0f);
    }
    var l4_j: i32 = 3i;
    var l5_k: i32 = (l4_j + 1i);
    a_P.x = ((a_P).x + f32((l5_k - l4_j)));
    if (((a_P).x != 0.0f)) {
        return;
    }
    a_P = (a_P * vec3f(2.0f));
}

@compute @workgroup_size(256)
fn main(@builtin(global_invocation_id) lsr_gid: vec3u, @builtin(num_workgroups) lsr_nwg: vec3u) {
    lsr_index = lsr_gid.x + lsr_gid.y * lsr_nwg.x * 256u;
    if (lsr_index >= lsr_header.count) {
        return;
    }
    a_N = attr_N[lsr_index];
    a_P = attr_P[lsr_index];
    lsr_kernel();
    attr_N[lsr_index] = a_N;
    attr_P[lsr_index] = a_P;
}

// Generated by lsr-kernel from a Points kernel. Do not edit: edit the kernel.

struct LsrUniforms {
    // time, time step, frame, 0
    globals: vec4f,
    // width, height, 1 / width, 1 / height (pixels)
    res: vec4f,
    p: array<vec4f, 1>,
}

// Parameters:
//   p[0] float = ch("radius")

struct LsrHeader {
    count: u32,
    capacity: u32,
}

@group(0) @binding(0) var<storage, read> lsr_header: LsrHeader;
@group(0) @binding(1) var<uniform> lsr_u: LsrUniforms;
@group(1) @binding(0) var<storage, read_write> attr_P: array<vec3<f32>>; // @P: vec3 (f32x3)
@group(1) @binding(1) var<storage, read> in_P: array<vec3<f32>>; // input values of @P for point()
@group(1) @binding(2) var<storage, read_write> attr_id: array<u32>; // @id: int (u32)
@group(1) @binding(3) var<storage, read> in_id: array<u32>; // input values of @id for point()
@group(1) @binding(4) var<storage, read_write> attr_seen: array<f32>; // @seen: float (f32)
@group(1) @binding(5) var<storage, read_write> attr_v: array<vec3<f32>>; // @v: vec3 (f32x3)

var<private> lsr_index: u32;
var<private> a_P: vec3f;
var<private> a_id: i32;
var<private> a_seen: f32;
var<private> a_v: vec3f;

fn lsr_point_P(i: i32) -> vec3f {
    if (i < 0i || u32(i) >= lsr_header.count) {
        return vec3f();
    }
    return in_P[u32(i)];
}

fn lsr_point_id(i: i32) -> i32 {
    if (i < 0i || u32(i) >= lsr_header.count) {
        return i32();
    }
    return i32(in_id[u32(i)]);
}

// The closest point to `pos` (lowest index on ties), or -1; maxdist < 0: no limit.
fn lsr_nearpoint(pos: vec3f, maxdist: f32) -> i32 {
    var best = -1i;
    var best_d2 = 0.0f;
    for (var k = 0u; k < lsr_header.count; k++) {
        let d = in_P[k] - pos;
        let d2 = dot(d, d);
        if (maxdist >= 0.0f && d2 > maxdist * maxdist) {
            continue;
        }
        if (best < 0i || d2 < best_d2) {
            best = i32(k);
            best_d2 = d2;
        }
    }
    return best;
}


fn lsr_kernel() {
    var l0_radius: f32 = lsr_u.p[0].x;
    var l1_sum: vec3f = vec3f(0.0f);
    var l2_count: i32 = 0i;
    {
        let lsr_np_pos0: vec3f = a_P;
        let lsr_np_r0: f32 = l0_radius;
        let lsr_np_max0: i32 = 16i;
        var lsr_np_found0: i32 = 0i;
        for (var lsr_np_k0: u32 = 0u; lsr_np_k0 < lsr_header.count; lsr_np_k0++) {
            if (lsr_np_found0 >= lsr_np_max0) {
                break;
            }
            let lsr_np_d0 = in_P[lsr_np_k0] - lsr_np_pos0;
            if (dot(lsr_np_d0, lsr_np_d0) > lsr_np_r0 * lsr_np_r0) {
                continue;
            }
            lsr_np_found0 = lsr_np_found0 + 1i;
            var l3_j: i32 = i32(lsr_np_k0);
            if ((l3_j == i32(lsr_index))) {
                continue;
            }
            l1_sum = (l1_sum + lsr_point_P(l3_j));
            l2_count = (l2_count + 1i);
        }
    }
    if ((l2_count > 0i)) {
        a_v = (a_v + (((l1_sum / vec3f(f32(l2_count))) - a_P) * vec3f(0.1f)));
    }
    var l4_nearest: i32 = lsr_nearpoint((a_P + vec3f(1.0f, 0.0f, 0.0f)), 2.0f);
    a_seen = select(f32((-1i)), f32(lsr_point_id(l4_nearest)), (l4_nearest >= 0i));
    a_id = (a_id + i32(lsr_header.count));
    a_P = (a_P + (a_v * vec3f(lsr_u.globals.y)));
}

@compute @workgroup_size(256)
fn main(@builtin(global_invocation_id) lsr_gid: vec3u, @builtin(num_workgroups) lsr_nwg: vec3u) {
    lsr_index = lsr_gid.x + lsr_gid.y * lsr_nwg.x * 256u;
    if (lsr_index >= lsr_header.count) {
        return;
    }
    a_P = attr_P[lsr_index];
    a_id = i32(attr_id[lsr_index]);
    a_seen = attr_seen[lsr_index];
    a_v = attr_v[lsr_index];
    lsr_kernel();
    attr_P[lsr_index] = a_P;
    attr_id[lsr_index] = u32(a_id);
    attr_seen[lsr_index] = a_seen;
    attr_v[lsr_index] = a_v;
}

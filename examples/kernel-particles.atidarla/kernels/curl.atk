// Curl noise + attract + age: the M2 AC2 particle kernel.
float freq   = ch("freq", 0.5, 0.0, 4.0);    // Noise frequency: lower makes wider swirls.
float amp    = ch("amp", 2.0, 0.0, 10.0);    // How hard the curl noise pushes.
float pull   = ch("attract", 0.3, 0.0, 5.0); // Spring toward the target.
vec3  target = chv("target", {0, 0, 0});     // Where the spring pulls.
float dt     = @TimeInc;
v@v += curlnoise(v@P * freq) * (amp * dt);
v@v += (target - v@P) * (pull * dt);
v@P += v@v * dt;
f@age += dt;

# The CPython the installers bundle (PRD A68): a relocatable build from
# astral-sh/python-build-standalone (PSF licence; see the runtime's
# LICENSE.txt, shipped as Python-License.txt). One pinned release for every
# platform; each script downloads its archive and refuses one whose SHA-256
# differs from the line below. Read by build-dmg.sh, build-appimage.sh
# (`. this file`) and build-msi.ps1 (KEY=VALUE lines).
#
# To move to a newer release: take the hashes from that release's SHA256SUMS
# file for the `install_only_stripped` archives, change every value
# together, and rebuild every installer.
PBS_RELEASE=20261013
PBS_PYTHON=3.13.16
PBS_SHA256_aarch64_apple_darwin=16a5332fb0dcb77f163fc8f8cbccd95be1644cc53e68e5d2a79f50afd6680a0e
PBS_SHA256_x86_64_apple_darwin=f507ae04eb7747cd97cb484e8c5d83936cbfc52d9b08a1f35c00b47c707b1ae1
PBS_SHA256_x86_64_pc_windows_msvc=7aba3985d4cee1c7cacb963ca6aa08a5d3e695d7f9609d9fabc56f22ddcf5a06
PBS_SHA256_x86_64_unknown_linux_gnu=d0080766b6b74aeb81e1949ef0d9a20e6c17f7b160fb295a69b936ccb17660be

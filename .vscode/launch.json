{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Atidarla app",
      "cargo": { "args": ["build", "-p", "atd-app"], "filter": { "name": "atidarla-app", "kind": "bin" } },
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "atidarla bench",
      "cargo": { "args": ["build", "-p", "atd-cli"], "filter": { "name": "atidarla", "kind": "bin" } },
      "args": ["bench"],
      "cwd": "${workspaceFolder}"
    }
  ]
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Lasair app",
      "cargo": { "args": ["build", "-p", "lsr-app"], "filter": { "name": "lasair-app", "kind": "bin" } },
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "lasair bench",
      "cargo": { "args": ["build", "-p", "lsr-cli"], "filter": { "name": "lasair", "kind": "bin" } },
      "args": ["bench"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
